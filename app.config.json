{
  "$schema": "./.dt-app/app.config.schema.json",
  "environmentUrl": "https://guu84124.apps.dynatrace.com",
  "app": {
    "name": "NavigatorIQ Launcher",
    "version": "0.3.65",
    "icon": "icon.svg",
    "description": "Persona-driven operational intelligence for Dynatrace (community app)",
    "id": "my.navigator.iq.app",
    "csp": {
      "img-src": [
        { "value": "https://guu84124.apps.dynatrace.com", "comment": "deployment status probe via icon.svg" }
      ]
    },
    "scopes": [
      { "name": "storage:logs:read", "comment": "read log data" },
      { "name": "storage:buckets:read", "comment": "read storage buckets" },
      { "name": "storage:metrics:read", "comment": "read host and service metrics" },
      { "name": "storage:entities:read", "comment": "read entity data" },
      { "name": "storage:smartscape:read", "comment": "read smartscape nodes (K8S entities)" },
      { "name": "storage:events:read", "comment": "read Davis problems and events" },
      { "name": "storage:spans:read", "comment": "read distributed traces" },
      { "name": "storage:system:read", "comment": "read system data" },
      { "name": "storage:security:read", "comment": "read security data" },
      { "name": "storage:user-sessions:read", "comment": "read user session / RUM event data for custom DQL metrics" },
      { "name": "storage:user.events:read", "comment": "read user.events table (RUM/DEM) for custom DQL metrics" },
      { "name": "environment-api:user-sessions:read", "comment": "environment API access to user session data for custom DQL metrics" },
      { "name": "environment-api:metrics:read", "comment": "read metrics v2" },
      { "name": "environment-api:entities:read", "comment": "read entities v2" },
      { "name": "state:user-app-states:read", "comment": "read per-user settings" },
      { "name": "state:user-app-states:write", "comment": "save per-user settings" },
      { "name": "state:app-states:read", "comment": "read shared settings" },
      { "name": "state:app-states:write", "comment": "save shared settings" }
    ]
  }
}
